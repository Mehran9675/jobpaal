{
  "name": "jobpaal",
  "version": "1.0.0",
  "private": true,
  "description": "JobPaal: tailor resumes, cover letters and screening answers to the job posting in front of you, with your own AI provider. Everything stays local.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.0.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
